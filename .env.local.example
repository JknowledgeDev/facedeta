# ============================================================
# AWS Rekognition  (Face Search AI)
# รับได้ที่: aws.amazon.com → IAM → Users → Create user
#   1. สมัคร AWS Account (ฟรี + $200 credit)
#   2. ไปที่ IAM → Users → Create user → ชื่อ "facedeta-user"
#   3. Attach policy: "AmazonRekognitionFullAccess"
#   4. Security credentials → Create access key → "Outside AWS"
#   5. คัดลอก Access key ID และ Secret access key
# Free tier: 5,000 รูป/เดือน (12 เดือนแรก)
# ============================================================
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
REKOGNITION_COLLECTION_ID=facedeta-collection

# ============================================================
# Google Drive API
# รับได้ที่: console.cloud.google.com
#   1. สร้าง Project ใหม่
#   2. APIs & Services → Enable "Google Drive API"
#   3. OAuth consent screen → External → กรอก App name
#      → Test users → เพิ่ม email ตัวเอง
#   4. Credentials → Create OAuth 2.0 Client ID → Desktop App
#   5. คัดลอก Client ID และ Client Secret
#   6. รัน: node get-token.js → รับ Refresh Token
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REFRESH_TOKEN=1//your_google_refresh_token

# ID ของ Google Drive Folder ที่เก็บรูป
# เปิด folder ใน browser → URL: .../folders/THIS_IS_THE_ID
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ============================================================
# Supabase  (เก็บ mapping faceId ↔ driveFileId)
# รับได้ที่: supabase.com → New Project → Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
